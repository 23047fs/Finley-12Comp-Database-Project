//Real rules
{
    "rules": {
        ".read": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
        //Allows any account with admin role to read and write
        "game": {
            ".read": true,
            "$uid": {
                ".write": "auth.uid === $uid"
            }
        },
        "geoGame": {
            ".read": true,
            "$uid": {
                ".write": "auth.uid === $uid"
            }
        },
        "users": {
            "$uid": {
                ".read": "auth.uid === $uid",
                ".write": "auth.uid === $uid"
                //Allows only your uid
            }
        }
    }
}
