//Real rules
{
    "rules": {
        ".read": "root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === 'lnaUwkd493YAAuYOCtv2U0RYQIB2'",
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === 'lnaUwkd493YAAuYOCtv2U0RYQIB2'",
        //Allows my account and any account with admin role to read and write
        "game": {
            ".read": true,
            "$uid": {
                ".write": "(auth != null && auth.uid === $uid)"
            }
        },
        "geoGame": {
            ".read": true,
            "$uid": {
                ".write": "(auth != null && auth.uid === $uid)"
            }
        },
        "users": {
            "$uid": {
                ".read": "(auth != null && auth.uid === $uid)",
                ".write": "(auth != null && auth.uid === $uid)"
                //Allows only your uid
            }
        }
    }
}
